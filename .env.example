# Copy to .env (gitignored). Never commit real values.

# Long random string: openssl rand -base64 48
SESSION_SECRET=
# Output of `pnpm hash-password`, single quotes included.
DASHBOARD_PASSWORD_HASH=

# ClickUp → Settings → Apps → API Token (starts with pk_)
CLICKUP_TOKEN=
# The number in app.clickup.com/<team_id>/... Several workspaces: separate
# the ids with commas. Only tasks assigned to you (or no one) count.
CLICKUP_TEAM_ID=

# Day/week boundaries for stats.
# IANA name, e.g. Europe/Helsinki
TZ=

DATABASE_PATH=./data/clickup.db
