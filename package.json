{
	"name": "clickup-dashboard",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3400 --strictPort",
		"build": "vite build",
		"start": "PORT=${PORT:-3400} node --env-file-if-exists=.env .output/server/index.mjs",
		"typecheck": "tsc --noEmit",
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"hash-password": "node scripts/hash-password.ts"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@node-rs/argon2": "^2.2.2",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.15",
		"@tanstack/react-query": "5.108.3",
		"@tanstack/react-query-devtools": "5.108.3",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.4",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.7",
		"@tanstack/react-table": "9.3.1",
		"better-sqlite3": "^13.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.2",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^0.577.0",
		"nitro": "3.0.260610-beta",
		"radix-ui": "^1.8.1",
		"react": "^19.2.0",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.2.0",
		"recharts": "3.8.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "0.8.7",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.11",
		"typescript": "^6.0.2",
		"vite": "^8.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.3.4"
}
